{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:writer": "tsx tests/writer.mjs",
    "test:writer-local": "node tests/writer-local.mjs",
    "test:writer-delta": "tsx tests/writer.mjs --delta-only",
    "test:writer-storage": "tsx tests/writer-storage.mjs",
    "bench:writer": "tsx tests/writer-performance.mjs --assert-optimized",
    "writer:cleanup": "tsx tools/writer-cleanup.ts",
    "test:writer-retention": "tsx tests/writer-retention.mjs",
    "test:writer-retention-process": "tsx tests/writer-retention-process.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.88",
    "@clerk/shared": "^4.44.1",
    "@google-cloud/storage": "^8.4.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dictionary-tr": "^2.0.0",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "htmlparser2": "^12.0.0",
    "http-proxy-middleware": "^4.2.1",
    "nspell": "^2.1.5",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nspell": "^2.1.6",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0",
    "tsx": "4.23.15"
  }
}
